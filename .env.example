# 复制为 .env 并填入真实取值。.env 已在 .gitignore 中，不会进版本库。
#
# 变量名统一带库名前缀：同一台 MySQL 上还有别的项目的库，DB_HOST 这类通用名容易撞。
# 建议给这个账号只授 SELECT 权限——本 agent 只观察不写入。

DCMA_DB_HOST=
DCMA_DB_PORT=3306
DCMA_DB_USER=
DCMA_DB_PASSWORD=
DCMA_DB_NAME=dcma

# 知识库。先运行 npm run knowledge:build，即可精确查码及 BM25 检索。
KNOWLEDGE_SNAPSHOT_PATH=knowledge/.index/snapshot.json

# 混合检索：独立 embedding 服务的 /v1 基地址。留空时只使用精确/BM25。
# Ollama 本地示例：http://127.0.0.1:11434/v1（先拉取 bge-m3）
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_MODEL=bge-m3
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_QDRANT_URL=http://127.0.0.1:6333
KNOWLEDGE_QDRANT_API_KEY=
# 可选：CPU 专用的社区镜像 alpine/ollama:0.12.3；默认使用官方镜像。
KNOWLEDGE_OLLAMA_IMAGE=ollama/ollama:0.12.3
